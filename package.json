{
  "name": "noiseless",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, Markdown-first productivity companion for Obsidian",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "starter": "tsx scripts/starter.ts",
    "package": "npm run build && npm run starter && node scripts/package.mjs"
  },
  "dependencies": { "yaml": "^2.8.1", "zod": "^4.1.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.1.0"
  }
}
